# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pricing-workflow?retryWrites=true&w=majority

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Pricing Workflow <your-email@gmail.com>"

# Designated pricing email
PRICING_EMAIL=testRates@domain.com

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# AWS Textract (optional — only needed when using the Textract OCR engine for image uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# External Pricing API
PRICING_API_URL=https://api.yourservice.com/prices
PRICING_API_KEY=your-pricing-api-key

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3041/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: restrict Google sign-in to a specific Workspace domain (e.g. yourcompany.com)
# Leave unset to allow any Google account
GOOGLE_WORKSPACE_DOMAIN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
