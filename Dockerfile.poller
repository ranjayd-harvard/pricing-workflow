FROM node:20-alpine

WORKDIR /app

# Install only what the poller needs
COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps

# Install googleapis and tsx (not in main package.json)
RUN npm install googleapis tsx --legacy-peer-deps

COPY scripts/gmail-poller.ts ./scripts/

CMD ["npx", "tsx", "scripts/gmail-poller.ts"]
